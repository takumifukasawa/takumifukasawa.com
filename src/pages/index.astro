---
// The only page of the site. It is the index and the detail view at once: a card opens the work itself
// in a new tab, so there are no per-sketch pages (docs/spec/site-v0.md).
//
// PROVISIONAL. P0 originally had no pages at all; this exists so the domain is not a 404 and so the first
// sketch has somewhere to appear. Fonts / colours / layout are decided in P1 (plan 1-1) once there are
// 5-10 sketches to look at — do not polish this before then.
import { getCollection } from 'astro:content';
import { resolveMedia } from '../lib/media.ts';

const sketches = (await getCollection('lab', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Where a card goes. The full fallback chain (externalUrl / video / poster) is P1; for now every sketch
// in lab/ is a built runtime work under /lab/<slug>/.
const hrefFor = (id: string, externalUrl?: string) => externalUrl ?? `/lab/${id}/`;

const dateLabel = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>takumifukasawa</title>
    <meta name="description" content="Takumi Fukasawa — graphics / realtime rendering. sketches and experiments." />
  </head>
  <body>
    <header>
      <h1>takumifukasawa</h1>
      <p>graphics / realtime rendering. 手を動かした記録を置いていく場所。</p>
    </header>

    <main>
      {
        sketches.length === 0 ? (
          <p class="empty">まだ何も置いていない。</p>
        ) : (
          <ul class="grid">
            {sketches.map((sketch) => {
              const poster = resolveMedia(sketch.data.poster);
              return (
                <li>
                  <a href={hrefFor(sketch.id, sketch.data.externalUrl)} target="_blank" rel="noopener">
                    <img
                      src={poster.url}
                      width={poster.width}
                      height={poster.height}
                      alt={sketch.data.title}
                      loading="lazy"
                    />
                    <span class="title">{sketch.data.title}</span>
                    <span class="meta">
                      <time datetime={sketch.data.date.toISOString()}>{dateLabel(sketch.data.date)}</time>
                      <span class="tags">{sketch.data.tags.join(' / ')}</span>
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #0b0b0d;
    --fg: #e8e8ea;
    --dim: #86868c;
    --line: #232328;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 5vw, 4rem);
    background: var(--bg);
    color: var(--fg);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 14px;
    line-height: 1.7;
  }

  header {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }

  h1 {
    margin: 0;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  header p {
    margin: 0.4rem 0 0;
    color: var(--dim);
  }

  .empty {
    color: var(--dim);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid a {
    display: grid;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  /* Square cards so portrait (1080x1920) and landscape sketches sit in the same grid. */
  .grid img {
    aspect-ratio: 1;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .grid a:hover img,
  .grid a:focus-visible img {
    border-color: var(--dim);
  }

  .title {
    line-height: 1.4;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    color: var(--dim);
    font-size: 0.85em;
  }
</style>
