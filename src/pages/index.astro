---
// The top page. It is the index and the detail view at once: a card opens the work itself in a new tab,
// so there are no per-sketch pages (docs/spec/site-v0.md). Head, header and links are in layouts/Base.astro.
//
// PROVISIONAL. P0 originally had no pages at all; this exists so the domain is not a 404 and so the first
// sketch has somewhere to appear. Fonts / colours / layout are decided in P1 (plan 1-1) once there are
// 5-10 sketches to look at — do not polish this before then.
//
// No prose. Not a tagline, not an empty-state sentence, not a section intro (AGENTS.md). With no sketches
// this page is the name and nothing else, and that is the intended state — the work is the content.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { resolveMedia } from '../lib/media.ts';

const sketches = (await getCollection('lab', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Where a card goes. The full fallback chain (externalUrl / video / poster) is P1; for now every sketch
// in lab/ is a built runtime work under /lab/<slug>/.
const hrefFor = (id: string, externalUrl?: string) => externalUrl ?? `/lab/${id}/`;

// How it opens is derived from where it goes, never stored per sketch. A work on this site opens in the
// same tab: its page carries the way back (_shell.js), and on a phone a new tab per sketch just piles up.
// Anything that leaves the site -- another repo's work, later a bare video or image -- has no way back, so
// it gets its own tab. Add a frontmatter field only if a real sketch ever needs to break this.
const opensInNewTab = (externalUrl?: string) => externalUrl !== undefined;

const dateLabel = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

// One string for both <meta name="description"> and og:description, so they cannot drift apart.
const description = 'Takumi Fukasawa — graphics / realtime rendering. sketches and experiments.';

// og:image is the newest published sketch's poster, and nothing when there is none. A default image was
// considered and dropped: a poster only exists after a recording, so the fallback would be a second,
// differently-made picture of the same work, used only while zero sketches are published -- dead the day
// the first one ships (docs/spec/site-v0.md).
//
// Do not share the site URL until a poster exists: X caches a card forever and the Card Validator is
// gone, so an image-less card cannot be fixed later (docs/learnings.md, 2026-10-08).
const ogImage = sketches.length > 0 ? resolveMedia(sketches[0]!.data.poster) : undefined;
---

<Base description={description} path="/" ogImage={ogImage}>
  {
    sketches.length > 0 && (
      <ul class="grid">
        {sketches.map((sketch) => {
          const poster = resolveMedia(sketch.data.poster);
          return (
            <li>
              <a
                href={hrefFor(sketch.id, sketch.data.externalUrl)}
                target={opensInNewTab(sketch.data.externalUrl) ? '_blank' : undefined}
                rel={opensInNewTab(sketch.data.externalUrl) ? 'noopener' : undefined}
              >
                <img
                  src={poster.url}
                  width={poster.width}
                  height={poster.height}
                  alt={sketch.data.title}
                  loading="lazy"
                />
                <span class="title">{sketch.data.title}</span>
                <span class="meta">
                  <time datetime={sketch.data.date.toISOString()}>{dateLabel(sketch.data.date)}</time>
                  <span class="tags">{sketch.data.tags.join(' / ')}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .grid a {
    display: grid;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
  }

  /* Square cards so portrait (1080x1920) and landscape sketches sit in the same grid. */
  .grid img {
    aspect-ratio: 1;
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .grid a:hover img,
  .grid a:focus-visible img {
    border-color: var(--dim);
  }

  .title {
    line-height: 1.4;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    color: var(--dim);
    font-size: 0.85em;
  }
</style>
