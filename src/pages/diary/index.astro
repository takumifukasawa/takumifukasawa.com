---
// /diary/ — the first page of the diary list (src/components/DiaryList.astro). Later pages: /diary/page/<n>/,
// each day: /diary/<YYYYMMDD>/.
// Kept out of search and crawlers: noindex here, X-Robots-Tag in public/_headers, AI crawlers in robots.txt, and
// never in the sitemap (docs/plans/active/diary-pipeline.md).
import { getCollection } from 'astro:content';
import DiaryList from '../../components/DiaryList.astro';
import Base from '../../layouts/Base.astro';

const days = await getCollection('diary');
---

<Base title="Diary" description="takumifukasawa の日記" path="/diary/" noindex>
  <DiaryList days={days} page={1} />
</Base>
