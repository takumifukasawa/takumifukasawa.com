---
// Everything the site's pages share: <head> (meta, OGP, analytics, the font), the header with the name and
// the links, and the base styles. Pages put their own content in the slot and their own styles next to it.
//
// PROVISIONAL like the pages themselves: fonts / colours / layout are decided in P1 (docs/spec/site-v0.md).
// The one exception already made is the font, so Japanese titles do not fall back to whatever the OS picks.
//
// No prose (AGENTS.md): the header is the name and labels, nothing else.
type Props = {
  // undefined on the top page, which is the site's name and nothing more.
  title?: string;
  description: string;
  // The page's own path, so og:url is that page and not the site root.
  path: string;
  ogImage?: { url: string; width: number; height: number };
};

const { title, description, path, ogImage } = Astro.props;
const fullTitle = title ? `${title} — takumifukasawa` : 'takumifukasawa';
const isHome = path === '/';

// Where else the work lives. Labels only -- the name of the place is the whole content. External ones open
// in a new tab; About is part of this site and does not. note is expected to join later.
const links = [
  { 'label': 'About', 'href': '/about/', 'external': false },
  { 'label': 'X', 'href': 'https://x.com/takumifukasawa', 'external': true },
  { 'label': 'GitHub', 'href': 'https://github.com/takumifukasawa', 'external': true },
  { 'label': 'Shadertoy', 'href': 'https://www.shadertoy.com/user/takumifukasawa', 'external': true },
  { 'label': 'Hatena Blog', 'href': 'https://takumifukasawa.hatenablog.com/', 'external': true },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- OGP. Absolute URLs come from `site` in astro.config.ts.
         summary_large_image needs an actual image, so without one the card falls back to the small form. -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site).href} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage.url} />}
    {ogImage && <meta property="og:image:width" content={String(ogImage.width)} />}
    {ogImage && <meta property="og:image:height" content={String(ogImage.height)} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <!-- M PLUS 1 Code: monospace with Japanese glyphs, so a Japanese title sits in the same face as the
         Latin around it. Plain Google Fonts; it serves Japanese in unicode-range slices on its own. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=M+PLUS+1+Code:wght@400;500&display=swap"
    />
    <!-- Google Analytics 4. The sketches are separate HTML files that the site does not generate, so they
         load the same id through public/_shell.js — change both together. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-L3EDWSFJ82"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-L3EDWSFJ82');
    </script>
  </head>
  <body>
    <header>
      {isHome ? <h1 class="name">takumifukasawa</h1> : <a class="name" href="/">takumifukasawa</a>}
      <ul class="links">
        {
          links.map((link) => (
            <li>
              {link.external ? (
                <a href={link.href} target="_blank" rel="noopener me">
                  {link.label}
                </a>
              ) : (
                <a href={link.href} aria-current={link.href === path ? 'page' : undefined}>
                  {link.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0b0b0d;
    --fg: #e8e8ea;
    --dim: #86868c;
    --line: #232328;
  }

  html {
    background: var(--bg);
  }

  body {
    margin: 0;
    padding: clamp(2rem, 6vw, 5rem) clamp(1rem, 5vw, 4rem);
    background: var(--bg);
    color: var(--fg);
    font-family: 'M PLUS 1 Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 14px;
    line-height: 1.7;
  }
</style>

<style>
  /* The site's frame, not the page's content: a step smaller than the body and set off by a line, so the
     first thing a page puts in <main> reads as that page's subject and not as a second title. */
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    padding-bottom: 1rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }

  .name {
    margin: 0;
    color: inherit;
    font-size: inherit;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  /* min-width: 0, or as a flex item the list keeps its one-line width and runs off a phone's edge instead
     of wrapping. */
  .links {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    /* Row gap for touch: on a phone the list wraps onto a second line, and two rows of small links set
       tight are easy to mis-tap. */
    gap: 0.5rem 1rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--dim);
    text-decoration: none;
  }

  .links a:hover,
  .links a:focus-visible,
  .links a[aria-current='page'] {
    color: var(--fg);
  }
</style>
