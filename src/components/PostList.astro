---
// The blog list (/blog/ and /blog/page/<n>/): date and title, one per line, newest first, then the pager.
// PROVISIONAL: how the list looks is decided in docs/plans/active/blog-migration.md, task 4.
import type { CollectionEntry } from 'astro:content';
import { BLOG_PAGE_SIZE, paginate } from '../lib/pages.ts';
import Pager from './Pager.astro';

type Props = { posts: CollectionEntry<'blog'>[]; page: number };
const { posts, page } = Astro.props;
const sorted = [...posts].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const { items, current, last } = paginate(sorted, page, BLOG_PAGE_SIZE);

const ymd = (d: Date) => d.toLocaleDateString('sv-SE', { timeZone: 'Asia/Tokyo' });
---

<h1>Blog</h1>
<ul class="posts">
  {
    items.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{ymd(post.data.date)}</time>
        <a href={`/blog/${post.id}/`}>{post.data.title}</a>
      </li>
    ))
  }
</ul>
<Pager base="/blog/" current={current} last={last} />

<style>
  h1 {
    margin: 0 0 1.5rem;
    color: var(--dim);
    font-size: 0.85em;
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .posts {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: 0 1rem;
  }

  time {
    color: var(--dim);
  }

  a {
    color: var(--fg);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
